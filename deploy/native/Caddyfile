# Brook gateway, native deployment. install.sh substitutes BROOK_DOMAIN.
#
# Caddy gets the certificate via Let's Encrypt HTTP-01 (TCP 80 must be reachable)
# and serves HTTP/1.1, HTTP/2 and HTTP/3 (UDP 443). It proxies REST and the /ws
# WebSocket to the api on loopback.
{
	# ACME account contact: expiry and incident notices from Let's Encrypt.
	email hi@madalin.me
}

BROOK_DOMAIN {
	# Compress everything except attachment bytes. On a download, compression rewrites
	# the ETag to "<sha256>-gzip" (clients check it against the file's sha256 for
	# If-Range) and answers a Range request with a gzipped body under an identity
	# Content-Range: a resumed download would be corrupt. Measured with caddy 2,
	# 2026-09-26. The bytes are for saving, never rendering, so nothing is lost.
	@compressible not path_regexp ^/api/v1/files/[^/]+/content$
	encode @compressible gzip
	# The dev call harness is off in production (BROOK_DEV_HARNESS unset); refuse
	# the path at the edge too so a config slip cannot expose it.
	respond /dev/* 404
	# Attachment bytes (attachments spec §3, §5). The api enforces the declared size;
	# this is a second cap in front of it. And a second layer of "never render, never
	# run" on downloads, in case a response ever left the api without its headers.
	@filecontent path_regexp ^/api/v1/files/[^/]+/content$
	request_body @filecontent {
		max_size 100MiB
	}
	header @filecontent {
		X-Content-Type-Options nosniff
		Content-Security-Policy "sandbox; default-src 'none'"
	}
	reverse_proxy 127.0.0.1:8000
}
