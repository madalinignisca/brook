# Copy to .env (or run `make init` to generate one with random secrets).
# NEVER commit .env. See ../docs/SECURITY.md §6 (secrets management).

# PostgreSQL
POSTGRES_USER=brook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brook

# API auth — MUST be a strong (>=32 char) random value; startup refuses a weak key.
BROOK_JWT_SIGNING_KEY=change-me-to-a-long-random-value-min-32-chars

# Gateway (Caddy) — host port for the plain-HTTP LAN endpoint (Phase 0).
BROOK_HTTP_PORT=8080

# --- Phase 2: object storage (only used with `make storage`) ---
MINIO_ROOT_USER=brook
MINIO_ROOT_PASSWORD=change-me
BROOK_MINIO_CONSOLE_PORT=9001
