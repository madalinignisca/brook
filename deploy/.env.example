# Copy to .env (or run `make init` to generate one with random secrets).
# NEVER commit .env. See ../docs/SECURITY.md §6 (secrets management).

# PostgreSQL
POSTGRES_USER=brook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brook

# API auth — MUST be a strong (>=32 char) random value; startup refuses a weak key.
BROOK_JWT_SIGNING_KEY=change-me-to-a-long-random-value-min-32-chars

# Gateway (Caddy) — plain-HTTP endpoint (Phase 0).
# BIND is the host address to listen on. Default loopback: reachable from this host only.
# For a LAN server set it to ONE LAN address (e.g. 192.168.1.10). Avoid 0.0.0.0: it can
# expose the server on every interface, including a public IPv6 address.
BROOK_HTTP_BIND=127.0.0.1
BROOK_HTTP_PORT=8080

# --- Phase 2: object storage (only used with `make storage`) ---
MINIO_ROOT_USER=brook
MINIO_ROOT_PASSWORD=change-me
BROOK_MINIO_CONSOLE_BIND=127.0.0.1
BROOK_MINIO_CONSOLE_PORT=9001
