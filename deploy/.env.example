# Copy to .env (or run `make init` to generate one with random secrets).
# NEVER commit .env. See ../docs/SECURITY.md §6 (secrets management).

# PostgreSQL
POSTGRES_USER=brook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=brook

# API auth — MUST be a strong (>=32 char) random value; startup refuses a weak key.
BROOK_JWT_SIGNING_KEY=change-me-to-a-long-random-value-min-32-chars

# Encryption of stored secrets (TOTP, bot secrets): `<id>:<32 random bytes,
# base64url, unpadded>`, plus the id that encrypts. `make init` (and `make up` on
# an older .env) generates them. The api refuses to boot without a valid ring.
# NEVER regenerate an existing key: every secret it encrypted becomes unreadable.
BROOK_SECRET_KEYS=change-me
BROOK_SECRET_PRIMARY_KEY_ID=1

# Gateway (Caddy) — plain-HTTP endpoint (Phase 0).
# BIND is the host address to listen on. Default loopback: reachable from this host only.
# For a LAN server set it to ONE LAN address (e.g. 192.168.1.10). Avoid 0.0.0.0: it can
# expose the server on every interface, including a public IPv6 address.
BROOK_HTTP_BIND=127.0.0.1
BROOK_HTTP_PORT=8080

# --- Phase 2: object storage (only used with `make storage`) ---
MINIO_ROOT_USER=brook
MINIO_ROOT_PASSWORD=change-me
BROOK_MINIO_CONSOLE_BIND=127.0.0.1
BROOK_MINIO_CONSOLE_PORT=9001

# --- Phase 4: media SFU (only used with `make media`) ---
# Shared secret between api and Janus. `make init` generates it.
JANUS_API_SECRET=change-me
# Address the media UDP ports are published on, and that clients send media to.
# Same rule as BROOK_HTTP_BIND: loopback by default, ONE LAN address for a LAN
# server, never 0.0.0.0 (that also binds public IPv6).
BROOK_MEDIA_BIND=127.0.0.1
BROOK_MEDIA_RTP_PORTS=20000-20099

# Container restart policy (compose). Default on-failure: the stack doesn't come back
# at boot (a dev laptop). An always-on host (the LAN test server) sets unless-stopped.
# BROOK_RESTART=unless-stopped
