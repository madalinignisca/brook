<!-- The three stream lines of the GNOME mark (clients/gnome/data/icons/dev.brook.Brook.svg),
     path data copied unchanged from its 128-unit canvas. The group scales it by 0.7 and centres
     it in the 108dp canvas, so it stays inside the 66dp circle every launcher mask keeps visible.
      -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="9.2"
        android:translateY="7.8">
        <path
            android:pathData="M28,46 C42,34 54,58 68,46 S94,34 100,44"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.95"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M28,66 C42,54 54,78 68,66 S94,54 100,64"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.8"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M28,86 C42,74 54,98 68,86 S94,74 100,84"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.65"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
    </group>
</vector>
