<!-- The blue of the GNOME mark's tile (clients/gnome/data/icons/dev.brook.Brook.svg), same
     top-to-bottom gradient. The launcher masks the 108dp square to its own shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:startColor="#3B8EE8"
                android:endColor="#1C5FB8" />
        </aapt:attr>
    </path>
</vector>
