  The window theme. Compose draws everything, so this only has to stop the system adding its
  own action bar (a second "Brook" above ours) and follow the system light/dark setting before
  the first frame.
-->
<resources>
    <style name="Theme.Brook" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
